# Copy to `.env` and fill in real values. Never commit `.env`.

PORT=4000

# Postgres connection string. For hosted providers that require TLS, keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Strong random secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of allowed CORS origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Optional: set to "false" (default) to verify the Postgres server TLS cert.
# Only set to "true" if your provider's cert chain is not trusted by Node.
PG_SSL_REJECT_UNAUTHORIZED=true
